{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "react-jsx", "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"], "types": ["node", "react"],
    "moduleSuffixes": [".native", ""], "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "android", "ios", "dist", "artifacts", "local-data", "backups", "exports"]
}
